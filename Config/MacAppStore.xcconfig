// Publishing-only override. The ordinary Release configuration remains
// Developer ID / Hardened Runtime for direct distribution.
CODE_SIGN_STYLE = Automatic
// The local archive is signed with the installed Apple Development identity;
// export re-signs the app with Cloud Managed Apple Distribution.
CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM = ULSR7BJ6SD
CODE_SIGN_ENTITLEMENTS = Tunix/Tunix-AppStore.entitlements
ENABLE_HARDENED_RUNTIME = NO
SWIFT_ACTIVE_COMPILATION_CONDITIONS = MAC_APP_STORE
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
GCC_GENERATE_DEBUGGING_SYMBOLS = YES
MARKETING_VERSION = 1.1.0
CURRENT_PROJECT_VERSION = 11
PRODUCT_BUNDLE_IDENTIFIER = Tunix-LLC.Tunix
